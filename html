// ensure we have at least 300; if less, duplicate some entries with suffix numbers
if(cities.length < 300){
  const base = cities.slice();
  let i = 1;
  while(cities.length < 300){
    const idx = (i-1) % base.length;
    const entry = Object.assign({}, base[idx]);
    // append small suffix to make distinct
    entry.city = entry.city + " " + Math.ceil(i/base.length);
    cities.push(entry);
    i++;
  }
}
// If we have more than 300, trim to 300
if(cities.length > 300) cities.length = 300;

// ---------- State ----------
let use24 = false;
let selectedIndex = null;
const favKey = 'tz_favs_v3';
const visitKey = 'tz_visit_v3';

// ---------- DOM refs ----------
const grid = $('#grid');
const heroCity = $('#heroCity');
const heroTime = $('#heroTime');
const heroOffset = $('#heroOffset');
const heroAmPm = $('#heroAmPm');
const heroStar = $('#heroStar');
const favList = $('#favList');
const searchInput = $('#searchInput');
const toggleFormat = $('#toggleFormat');
const visitBox = $('#visitBox');
const clearBtn = $('#clearBtn');
const showFavsBtn = $('#showFavs');

// ---------- Local Storage: visits ----------
(function initVisits(){
  try {
    const raw = localStorage.getItem(visitKey);
    const val = raw ? parseInt(raw,10) : 0;
    const next = val + 1;
    localStorage.setItem(visitKey, String(next));
    visitBox.textContent = `Visits: ${next}`;
  } catch(e){
    visitBox.textContent = `Visits: ?`;
  }
})();

// ---------- Render grid ----------
function renderGrid(list){
  grid.innerHTML = '';
  list.forEach((c, idx) => {
    const div = document.createElement('div');
    div.className = 'card';
    div.dataset.index = idx;
    div.innerHTML = `
      <div class="star" data-idx="${idx}">☆</div>
      <div class="city-name">${escapeHtml(c.city)}</div>
      <div class="tz-name">${escapeHtml(c.tz)}</div>
      <div style="height:6px"></div>
      <div class="time-small" id="time-${idx}">--:--</div>
      <div class="small-meta" id="meta-${idx}"></div>
    `;
    div.addEventListener('click', (e)=>{
      if(e.target.classList.contains('star')){
        // handled below
        return;
      }
      selectCard(idx);
    });
    grid.appendChild(div);
  });
  updateAllTimes();
  renderStars();
}

function escapeHtml(s){ return String(s).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;'); }

// ---------- Update times periodically ----------
function updateAllTimes(){
  const now = new Date();
  const cards = grid.querySelectorAll('.card');
  cards.forEach(card=>{
    const idx = Number(card.dataset.index);
    const entry = cities[idx];
    const parts = getTimeParts(entry.tz, now, use24);
    const timeEl = card.querySelector(`#time-${idx}`);
    const metaEl = card.querySelector(`#meta-${idx}`);
    if(timeEl) timeEl.textContent = parts.hourMinSec + (parts.ampm ? ' ' + parts.ampm : '');
    if(metaEl) metaEl.textContent = parts.offset;
    if(selectedIndex === idx){
      // highlight selected
      card.classList.add('selected');
    } else {
      card.classList.remove('selected');
    }
  });

  // update hero
  if(selectedIndex !== null){
    const e = cities[selectedIndex];
    const p = getTimeParts(e.tz, now, use24);
    heroCity.textContent = e.city;
    heroTime.textContent = p.timeStr;
    heroOffset.textContent = p.offset;
    heroAmPm.textContent = p.ampm || (use24 ? '24h' : '');
    // star state
    updateHeroStar();
  } else {
    // show local
    const localTz = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
    const p = getTimeParts(localTz, now, use24);
    heroCity.textContent = `${localTz} (local)`;
    heroTime.textContent = p.timeStr;
    heroOffset.textContent = p.offset;
    heroAmPm.textContent = p.ampm || (use24 ? '24h' : '');
    heroStar.textContent = '☆';
  }
}

// tick every second
setInterval(updateAllTimes, 1000);

// ---------- Selection ----------
function selectCard(idx){
  selectedIndex = idx;
  // show in hero
  updateAllTimes();
  // scroll hero into view on small screens
  document.querySelector('.hero').scrollIntoView({behavior:'smooth'});
}

// ---------- Favorites ----------
function loadFavs(){
  try {
    const raw = localStorage.getItem(favKey);
    return raw ? JSON.parse(raw) : [];
  } catch(e){ return []; }
}
function saveFavs(arr){
  try { localStorage.setItem(favKey, JSON.stringify(arr)); } catch(e){}
}
function isFav(city){
  const favs = loadFavs();
  return favs.includes(city);
}
function toggleFavByCity(city){
  const favs = loadFavs();
  const idx = favs.indexOf(city);
  if(idx >= 0) favs.splice(idx,1);
  else favs.push(city);
  saveFavs(favs);
  renderStars();
  renderFavList();
  updateHeroStar();
}
function renderStars(){
  const favs = loadFavs();
  const starEls = grid.querySelectorAll('.star');
  starEls.forEach(el=>{
    const idx = Number(el.dataset.idx);
    const c = cities[idx];
    el.textContent = favs.includes(c.city) ? '★' : '☆';
    el.onclick = (e)=>{
      e.stopPropagation();
      toggleFavByCity(c.city);
    };
  });
  updateHeroStar();
}
function renderFavList(){
  favList.innerHTML = '';
  const favs = loadFavs();
  if(favs.length === 0){
    favList.innerHTML = '<div style="color:var(--muted);font-size:13px">No favorites yet — click the star on a card to save</div>';
    return;
  }
  favs.forEach(f=>{
    const btn = document.createElement('button');
    btn.className = 'chip';
    btn.textContent = f;
    btn.onclick = ()=> {
      // find the city index and select
      const idx = cities.findIndex(c=>c.city===f);
      if(idx>=0) selectCard(idx);
      else {
        alert('Favorite not found in list.');
      }
    };
    favList.appendChild(btn);
  });
}
function updateHeroStar(){
  if(selectedIndex===null){
    heroStar.textContent = '☆';
    heroStar.onclick = () => {};
    return;
  }
  const c = cities[selectedIndex];
  heroStar.textContent = isFav(c.city) ? '★' : '☆';
  heroStar.onclick = (e) => {
    e.stopPropagation();
    toggleFavByCity(c.city);
  };
}

// ---------- Search ----------
function performSearch(q){
  q = (q||'').trim();
  if(!q){
    renderGrid(cities);
    return;
  }
  const scores = cities.map((c, idx) => {
    const primary = fuzzyScore(q, c.city);
    const secondary = fuzzyScore(q, c.tz || '');
    return {idx, score: Math.min(primary, secondary)};
  });
  scores.sort((a,b)=>a.score - b.score);
  // take top 60 matches to show
  const top = scores.slice(0,200).map(s=>cities[s.idx]);
  renderGrid(top);
  // if the best score is very close, auto-select top result
  if(scores.length && scores[0].score <= 0.25){
    selectCard(scores[0].idx);
  }
}

// ---------- Controls ----------
toggleFormat.addEventListener('click', ()=>{
  use24 = !use24;
  toggleFormat.textContent = use24 ? '24h' : '12h';
  updateAllTimes();
});
clearBtn.addEventListener('click', ()=>{
  searchInput.value = '';
  performSearch('');
});

searchInput.addEventListener('input', (e)=>{
  const q = e.target.value;
  // search but be lenient: if empty show all
  performSearch(q);
});

searchInput.addEventListener('keydown', (e)=>{
  if(e.key === 'Enter'){
    // focus hero by selecting best match (top card)
    const firstCard = grid.querySelector('.card');
    if(firstCard){
      const idx = Number(firstCard.dataset.index);
      selectCard(idx);
      firstCard.scrollIntoView({behavior:'smooth', block:'center'});
    }
  }
});

document.querySelectorAll('.chip[data-quick]').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    const q = btn.dataset.quick;
    if(q === 'local'){
      selectedIndex = null;
      updateAllTimes();
      return;
    }
    // find first city with matching tz
    const idx = cities.findIndex(c=>c.tz === q || c.city.includes(q));
    if(idx >= 0) selectCard(idx);
    else alert('Quick pick not found.');
  });
});

showFavsBtn.addEventListener('click', ()=>{
  const favs = loadFavs();
  if(favs.length===0){ alert('No favorites yet (saved locally).'); return; }
  // filter cities to only favorites
  const filtered = cities.filter(c=>favs.includes(c.city));
  renderGrid(filtered);
});

// ---------- Helpers ----------
function findClosestCityByName(q){
  const scores = cities.map((c, idx) => ({idx, score:fuzzyScore(q,c.city)}));
  scores.sort((a,b)=>a.score-b.score);
  return scores[0];
}

// ---------- Initial render ----------
renderGrid(cities);
renderFavList();

// expose selectCard for debug
window.selectCard = selectCard;

// set local timezone as initial hero
updateAllTimes();

</script>
