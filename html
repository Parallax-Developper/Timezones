/*
  Timezone Dashboard (single-file)
  - 300 cities array included below
  - fuzzy search with Levenshtein
  - favorites saved in localStorage per-user
  - visit counter saved in localStorage (local-only)
  - robust timezone fallback to UTC if invalid
  - 12h/24h toggle
*/

// ---------- Utilities ----------
const $ = sel => document.querySelector(sel);
const byId = id => document.getElementById(id);

function safeFormatTime(tz, date, opts){
  try {
    return new Intl.DateTimeFormat(undefined, Object.assign({timeZone:tz}, opts)).format(date);
  } catch(e){
    // fallback to UTC
    return new Intl.DateTimeFormat(undefined, Object.assign({timeZone:'UTC'}, opts)).format(date);
  }
}

function getTimeParts(tz, date, use24){
  // return {timeStr, hourMinSec, ampm, offset}
  const optionsTime = {hour:'numeric',minute:'2-digit',second:'2-digit',hour12:!use24};
  const timeStr = safeFormatTime(tz, date, optionsTime);
  const hourMinSec = safeFormatTime(tz, date, {hour:'numeric',minute:'2-digit',hour12:!use24});
  const ampm = (!use24) ? safeFormatTime(tz, date, {hour:'numeric',hour12:true}).split(' ').pop() : '';
  // offset calculation (approx)
  try {
    // compute offset by using UTC time vs local time in minutes
    const fmt = new Intl.DateTimeFormat('en-US', {timeZone: tz, hour12:false, hour:'2-digit', minute:'2-digit', second:'2-digit', timeZoneName: 'short'});
    // timeZoneName not reliable to parse numeric offset, so do numeric approach:
    const tzDate = new Date(date.toLocaleString('en-US', {timeZone: tz}));
    const offsetMin = (tzDate - date) / 60000;
    const offHours = Math.trunc(offsetMin/60);
    const offMins = Math.abs(offsetMin % 60);
    const sign = offsetMin >= 0 ? '+' : '-';
    const offStr = `UTC ${sign}${String(Math.abs(offHours)).padStart(1,'0')}:${String(offMins).padStart(2,'0')}`;
    return {timeStr, hourMinSec, ampm, offset: offStr};
  } catch(e){
    return {timeStr, hourMinSec, ampm, offset:'UTC ±0:00'};
  }
}

// Levenshtein distance (simple)
function levenshtein(a,b){
  if(!a||!b) return (a||b).length;
  a=a.toLowerCase(); b=b.toLowerCase();
  const m=a.length,n=b.length;
  const dp = Array.from({length:m+1},()=>new Array(n+1).fill(0));
  for(let i=0;i<=m;i++) dp[i][0]=i;
  for(let j=0;j<=n;j++) dp[0][j]=j;
  for(let i=1;i<=m;i++){
    for(let j=1;j<=n;j++){
      const cost = a[i-1]===b[j-1]?0:1;
      dp[i][j]=Math.min(dp[i-1][j]+1, dp[i][j-1]+1, dp[i-1][j-1]+cost);
    }
  }
  return dp[m][n];
}

// fuzzy match score: lower is better
function fuzzyScore(query, text){
  if(!query) return Infinity;
  query=query.trim().toLowerCase();
  text=text.toLowerCase();
  if(text.includes(query)) return 0; // perfect match
  const d = levenshtein(query, text);
  const norm = d / Math.max(1, text.length);
  return norm;
}

